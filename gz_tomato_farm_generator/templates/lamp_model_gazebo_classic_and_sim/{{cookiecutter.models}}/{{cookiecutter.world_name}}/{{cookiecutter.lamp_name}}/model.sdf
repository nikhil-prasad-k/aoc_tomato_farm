<sdf version="1.6">
  <model name="{{cookiecutter.lamp_name}}">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 1</size> 
          </box>
        </geometry>
      </collision>
      <visual name="lamp">
        <geometry>
          <mesh>
            <uri>model://{{cookiecutter.lamp_name}}/meshes/lamp.dae</uri>
            <scale>0.005 0.005 0.005</scale> 
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
        </material>
      </visual>

      <light name='lightComponent' type='point'>
        <diffuse>0.26 0.26 0.26 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <attenuation>
          <range>7</range>
          <constant>{{cookiecutter.light_constant}}</constant>     
          <linear>{{cookiecutter.light_linear}}</linear>
          <quadratic>{{cookiecutter.light_quadratic}}</quadratic>
        </attenuation>
        <!-- shadows disabled 2026-08-28: 6 shadow-casting point lights was a real render
             cost (point-light shadows need a multi-pass cubemap render, x6), for minimal
             visual payoff under a diffuse glasshouse roof. Light itself is unchanged. -->
        <cast_shadows>0</cast_shadows>
        <direction>0 0 -1</direction>
      </light>


    </link>
  </model>
</sdf>
